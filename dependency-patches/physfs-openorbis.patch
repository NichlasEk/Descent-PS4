diff --git a/src/physfs_platform_posix.c b/src/physfs_platform_posix.c
index 7ba5e10..9a9ba4e 100644
--- a/src/physfs_platform_posix.c
+++ b/src/physfs_platform_posix.c
@@ -23,6 +23,54 @@
 
 #include "physfs_internal.h"
 
+#ifdef __ORBIS__
+#include <stddef.h>
+#include <orbis/libkernel.h>
+/* SDK mode_t is wider than the native kernel ABI in this toolchain. */
+struct ps4_native_stat {
+    uint32_t dev, ino;
+    uint16_t mode, nlink;
+    uint32_t uid, gid, rdev;
+    struct timespec atim, mtim, ctim;
+    int64_t size, blocks;
+    uint32_t blksize, flags, gen;
+    int32_t spare;
+    struct timespec birthtim;
+};
+_Static_assert(offsetof(struct ps4_native_stat, size) == 72, "PS4 stat size offset");
+_Static_assert(sizeof(struct ps4_native_stat) == 120, "PS4 stat ABI size");
+static void ps4_convert_stat(struct stat *out, const struct ps4_native_stat *in) {
+    memset(out, 0, sizeof(*out));
+    out->st_mode = in->mode;
+    out->st_size = in->size;
+    out->st_blocks = in->blocks;
+    out->st_atim = in->atim;
+    out->st_mtim = in->mtim;
+    out->st_ctim = in->ctim;
+}
+static int ps4_result(int rc) {
+    if (rc >= 0) return rc;
+    errno = (unsigned)rc & 0xffff;
+    return -1;
+}
+static int ps4_stat(const char *path, struct stat *st) {
+    struct ps4_native_stat native;
+    int rc = ps4_result(sceKernelStat(path, (OrbisKernelStat *)&native));
+    if (rc == 0) ps4_convert_stat(st, &native);
+    return rc;
+}
+static int ps4_fstat(int fd, struct stat *st) {
+    struct ps4_native_stat native;
+    int rc = ps4_result(sceKernelFstat(fd, (OrbisKernelStat *)&native));
+    if (rc == 0) ps4_convert_stat(st, &native);
+    return rc;
+}
+/* This port explicitly permits symlinks and follows them for metadata. */
+#define stat(path, st) ps4_stat(path, st)
+#define lstat(path, st) ps4_stat(path, st)
+#define fstat(fd, st) ps4_fstat(fd, st)
+#endif
+
 
 static PHYSFS_ErrorCode errcodeFromErrnoError(const int err)
 {
